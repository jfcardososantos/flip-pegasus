# URL base de uma instalação WordPress que você tem autorização para consultar.
# Exemplo: https://catalogo.exemplo.com
SOURCE_BASE_URL=
SOURCE_CATEGORY=ps4
SOURCE_PER_PAGE=100
# Número de páginas buscadas simultaneamente; mantenha baixo para respeitar a fonte.
SOURCE_PAGE_CONCURRENCY=4

# A atualização inicial é feita ao iniciar o container. Para desativá-la, use false.
UPDATE_ON_START=true
UPDATE_INTERVAL_MINUTES=720
PORT=3000
DATA_DIR=/app/data
