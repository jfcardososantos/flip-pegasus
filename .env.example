# URL base da fonte de dados
# Para WordPress: https://catalogo.exemplo.com
# Para DLPSGame: https://dlpsgame.com
SOURCE_BASE_URL=https://dlpsgame.com

# Categoria a ser extraída (para DLPSGame: ps4, ps3, ps5, etc.)
SOURCE_CATEGORY=ps4

# Tipo de fonte: 'wordpress' (padrão) ou 'dlpsgame'
SOURCE_TYPE=dlpsgame

# Nome do catálogo gerado
CATALOG_NAME=DLPSGame PS4 Catalog

# Quantos jogos por página (máximo 100 para WordPress)
SOURCE_PER_PAGE=100

# Número de páginas buscadas simultaneamente (apenas WordPress)
SOURCE_PAGE_CONCURRENCY=4

# A atualização inicial é feita ao iniciar o container. Para desativá-la, use false.
UPDATE_ON_START=true

# Intervalo de atualização em minutos (padrão: 720 = 12 horas)
UPDATE_INTERVAL_MINUTES=720

# Porta do servidor HTTP
PORT=3000

# Diretório para armazenar os dados
DATA_DIR=/app/data
